# Original ESP32 with 4 MB flash; required by partitions.csv.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE provisioning using NimBLE.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_ENABLED=y

# BLE provisioning with Security 1.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_NETWORK_PROV_NETWORK_TYPE_WIFI=y

# Full-4-MiB OTA slots and SPIFFS layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# IDF 6.x places FreeRTOS functions in flash unless this option is enabled.
CONFIG_FREERTOS_IN_IRAM=n

# Require valid certificate dates after SNTP synchronization.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# Anjay with the Mbed TLS 4 compatibility patch.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_ANJAY_LIBRARY_WITH_TRACE_LOGS=n
CONFIG_ANJAY_WITH_DOWNLOADER=n
CONFIG_ANJAY_WITH_MODULE_FW_UPDATE=y
CONFIG_ANJAY_WITH_MODULE_ADVANCED_FW_UPDATE=n
CONFIG_ANJAY_WITH_MODULE_SW_MGMT=n
CONFIG_ANJAY_WITH_BOOTSTRAP=n
CONFIG_ANJAY_WITH_LWM2M11=y
CONFIG_ANJAY_WITH_SECURITY_STRUCTURED=y
CONFIG_ANJAY_WITH_SEND=n
CONFIG_ANJAY_WITH_SENML_JSON=n
# LwM2M 1.1 representation support; ThingsBoard may still request TLV.
CONFIG_ANJAY_WITH_CBOR=y
CONFIG_ANJAY_WITH_MODULE_IPSO_OBJECTS=n
CONFIG_ANJAY_WITH_THREAD_SAFETY=n
